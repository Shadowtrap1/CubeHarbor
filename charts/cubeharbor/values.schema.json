        "records": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serverHostnames": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+[smh]$"
        },
        "ttl": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "ipLookupUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteMany",
            "ReadWriteOnce",
            "ReadWriteOncePod",
            "ReadOnlyMany"
          ]
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "description": "Must be 1: port allocation is coordinated in one process."
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
